{
  "name": "busybox",
  "displayName": "BusyBox",
  "description": "BusyBox terminal for the PythOnline browser workspace.",
  "version": "0.1.0",
  "publisher": "Pandorka132",
  "engines": { "vscode": "^1.100.0" },
  "browser": "./extension.js",
  "activationEvents": [
    "onTerminalProfile:pythonline.busybox"
  ],
  "contributes": {
    "terminal": {
      "profiles": [
        {
          "title": "BusyBox",
          "id": "pythonline.busybox"
        }
      ]
    },
    "commands": [
      {
        "command": "busybox.open",
        "title": "BusyBox: New Terminal",
        "icon": "$(terminal)"
      }
    ]
  }
}